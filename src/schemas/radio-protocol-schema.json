{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Radio Protocol DSL Schema",
  "description": "Schema for defining radio communication protocols in a declarative JSON format",
  "type": "object",
  "required": [
    "id",
    "version",
    "description",
    "serialConfig",
    "memoryConfig",
    "settingsSchema",
    "readMemory",
    "writeMemory"
  ],
  "properties": {
    "id": {
      "type": "object",
      "description": "Radio identification information",
      "required": [
        "model",
        "name",
        "manufacturer"
      ],
      "properties": {
        "model": {
          "type": "string",
          "description": "Radio model identifier"
        },
        "name": {
          "type": "string",
          "description": "Human-readable radio name"
        },
        "manufacturer": {
          "type": "string",
          "description": "Radio manufacturer name"
        }
      }
    },
    "version": {
      "type": "string",
      "description": "Version of the radio configuration",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the radio configuration"
    },
    "settingsSchema": {
      "type": "object",
      "description": "Schema definitions for radio settings and channels",
      "required": [
        "model",
        "settingsSchema",
        "channelSchema"
      ],
      "properties": {
        "model": {
          "type": "string",
          "description": "Radio model identifier"
        },
        "settingsSchema": {
          "type": "object",
          "description": "JSON schema for radio settings"
        },
        "channelSchema": {
          "type": "object",
          "description": "JSON schema for radio channels"
        }
      }
    },
    "serialConfig": {
      "type": "object",
      "description": "Serial port configuration",
      "required": [
        "baudRate"
      ],
      "properties": {
        "baudRate": {
          "type": "integer",
          "description": "Serial baud rate",
          "minimum": 1200,
          "maximum": 115200
        },
        "dataBits": {
          "type": "integer",
          "description": "Number of data bits",
          "enum": [
            5,
            6,
            7,
            8
          ],
          "default": 8
        },
        "stopBits": {
          "oneOf": [
            {
              "type": "integer",
              "enum": [
                1,
                2
              ]
            },
            {
              "type": "number",
              "enum": [
                1.5
              ]
            }
          ],
          "description": "Number of stop bits",
          "default": 1
        },
        "parity": {
          "type": "string",
          "enum": [
            "none",
            "even",
            "odd"
          ],
          "default": "none"
        }
      }
    },
    "memoryConfig": {
      "type": "object",
      "description": "Memory configuration for radio segments",
      "required": [
        "chunkSize",
        "addressSize",
        "segments"
      ],
      "properties": {
        "chunkSize": {
          "type": "integer",
          "description": "Size of memory chunks in bytes",
          "minimum": 1
        },
        "addressSize": {
          "type": "integer",
          "description": "Size of addresses in bytes for memory operations",
          "minimum": 1,
          "maximum": 4
        },
        "segments": {
          "type": "object",
          "description": "Memory segment definitions",
          "additionalProperties": {
            "type": "object",
            "required": [
              "startAddress",
              "endAddress"
            ],
            "properties": {
              "startAddress": {
                "type": "integer",
                "description": "Starting address of the memory segment",
                "minimum": 0
              },
              "endAddress": {
                "type": "integer",
                "description": "Ending address (inclusive) of the memory segment",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "readMemory": {
      "type": "array",
      "description": "Protocol steps for reading memory",
      "items": {
        "$ref": "#/definitions/protocolStep"
      }
    },
    "writeMemory": {
      "type": "array",
      "description": "Protocol steps for writing memory",
      "items": {
        "$ref": "#/definitions/protocolStep"
      }
    }
  },
  "definitions": {
    "protocolStep": {
      "type": "object",
      "description": "A single protocol step",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "sendReceive"
          ],
          "properties": {
            "sendReceive": {
              "$ref": "#/definitions/sendReceiveStep"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "send"
          ],
          "properties": {
            "send": {
              "$ref": "#/definitions/sendStep"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "receive"
          ],
          "properties": {
            "receive": {
              "$ref": "#/definitions/receiveStep"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "readSegment"
          ],
          "properties": {
            "readSegment": {
              "$ref": "#/definitions/readSegmentStep"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "writeSegment"
          ],
          "properties": {
            "writeSegment": {
              "$ref": "#/definitions/writeSegmentStep"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "setVariable"
          ],
          "properties": {
            "setVariable": {
              "$ref": "#/definitions/setVariableStep"
            }
          }
        }
      ]
    },
    "sendReceiveStep": {
      "type": "object",
      "description": "Send data and receive response",
      "required": [
        "send",
        "receive"
      ],
      "properties": {
        "send": {
          "$ref": "#/definitions/sendData"
        },
        "receive": {
          "$ref": "#/definitions/receiveConfig"
        },
        "timeout": {
          "type": "integer",
          "description": "Timeout in milliseconds",
          "minimum": 1,
          "default": 5000
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of the step"
        }
      }
    },
    "sendStep": {
      "type": "object",
      "description": "Send data only",
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "$ref": "#/definitions/sendData"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of the step"
        }
      }
    },
    "receiveStep": {
      "type": "object",
      "description": "Receive data only",
      "required": [
        "type",
        "length"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "exact",
            "variable",
            "pattern",
            "any"
          ],
          "description": "Type of receive operation"
        },
        "value": {
          "type": "integer",
          "description": "Expected value for exact match",
          "minimum": 0,
          "maximum": 255
        },
        "length": {
          "type": "integer",
          "description": "Expected length in bytes",
          "minimum": 1
        },
        "pattern": {
          "type": "array",
          "description": "Pattern for structured responses",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "description": "Literal value (1 byte)"
              },
              {
                "type": "number",
                "description": "Literal value (1 byte)"
              },
              {
                "type": "object",
                "required": [
                  "field",
                  "size"
                ],
                "properties": {
                  "field": {
                    "type": "string",
                    "description": "Field name for extracted data"
                  },
                  "size": {
                    "type": "integer",
                    "description": "Size in bytes (0 for variable length)",
                    "minimum": 0
                  }
                }
              }
            ]
          }
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of the step"
        }
      }
    },
    "readSegmentStep": {
      "type": "object",
      "description": "Read memory segments",
      "required": [
        "segments",
        "startChunk",
        "endChunk"
      ],
      "properties": {
        "segments": {
          "type": "array",
          "description": "List of segment names to read",
          "items": {
            "type": "string"
          }
        },
        "startChunk": {
          "$ref": "#/definitions/sendReceiveStep",
          "description": "Protocol for starting a chunk read"
        },
        "endChunk": {
          "$ref": "#/definitions/sendReceiveStep",
          "description": "Protocol for ending a chunk read"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of the step"
        }
      }
    },
    "writeSegmentStep": {
      "type": "object",
      "description": "Write memory segments",
      "required": [
        "segments",
        "send",
        "data",
        "receive"
      ],
      "properties": {
        "segments": {
          "type": "array",
          "description": "List of segment names to write",
          "items": {
            "type": "string"
          }
        },
        "send": {
          "$ref": "#/definitions/sendData",
          "description": "Data to send for write command"
        },
        "data": {
          "type": "string",
          "description": "Expression for segment data to write"
        },
        "receive": {
          "$ref": "#/definitions/receiveConfig",
          "description": "Expected response for write command"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of the step"
        }
      }
    },
    "setVariableStep": {
      "type": "object",
      "description": "Set a variable value",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Variable name"
        },
        "value": {
          "oneOf": [
            {
              "type": "string",
              "description": "Expression or literal value"
            },
            {
              "type": "number",
              "description": "Numeric value"
            }
          ],
          "description": "Value to assign to the variable"
        }
      }
    },
    "sendData": {
      "type": "array",
      "description": "Array of data to send",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "description": "String literal or expression"
          },
          {
            "type": "number",
            "description": "Numeric literal or expression",
            "minimum": 0,
            "maximum": 255
          }
        ]
      }
    },
    "receiveConfig": {
      "type": "object",
      "description": "Configuration for receiving data",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "exact",
            "variable",
            "pattern",
            "any"
          ],
          "description": "Type of receive operation"
        },
        "value": {
          "type": "integer",
          "description": "Expected value for exact match",
          "minimum": 0,
          "maximum": 255
        },
        "length": {
          "type": "integer",
          "description": "Expected length in bytes",
          "minimum": 1
        },
        "pattern": {
          "type": "array",
          "description": "Pattern for structured responses",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "description": "Literal value (1 byte)"
              },
              {
                "type": "number",
                "description": "Literal value (1 byte)"
              },
              {
                "type": "object",
                "required": [
                  "field",
                  "size"
                ],
                "properties": {
                  "field": {
                    "type": "string",
                    "description": "Field name for extracted data"
                  },
                  "size": {
                    "type": "integer",
                    "description": "Size in bytes (0 for variable length)",
                    "minimum": 0
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
