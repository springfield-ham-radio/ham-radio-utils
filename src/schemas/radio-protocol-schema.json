{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Radio Protocol DSL Schema",
  "description": "Schema for defining radio communication protocols as send/expect exchanges",
  "type": "object",
  "required": [
    "id",
    "version",
    "description",
    "serialConfig",
    "memoryConfig",
    "settingsSchema",
    "readMemory",
    "writeMemory"
  ],
  "properties": {
    "id": {
      "type": "object",
      "description": "Radio identification information",
      "required": [
        "model",
        "name",
        "manufacturer"
      ],
      "properties": {
        "model": {
          "type": "string",
          "description": "Radio model identifier"
        },
        "name": {
          "type": "string",
          "description": "Human-readable radio name"
        },
        "manufacturer": {
          "type": "string",
          "description": "Radio manufacturer name"
        }
      }
    },
    "version": {
      "type": "string",
      "description": "Version of the radio configuration",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the radio configuration"
    },
    "settingsSchema": {
      "type": "object",
      "description": "Schema definitions for radio settings and channels",
      "required": [
        "model",
        "settingsSchema",
        "channelSchema"
      ],
      "properties": {
        "model": {
          "type": "string",
          "description": "Radio model identifier"
        },
        "settingsSchema": {
          "type": "object",
          "description": "JSON schema for radio settings"
        },
        "channelSchema": {
          "type": "object",
          "description": "JSON schema for radio channels"
        }
      }
    },
    "serialConfig": {
      "type": "object",
      "description": "Serial port configuration",
      "required": [
        "baudRate"
      ],
      "properties": {
        "baudRate": {
          "type": "integer",
          "description": "Serial baud rate",
          "minimum": 1200,
          "maximum": 115200
        },
        "dataBits": {
          "type": "integer",
          "description": "Number of data bits",
          "enum": [
            5,
            6,
            7,
            8
          ],
          "default": 8
        },
        "stopBits": {
          "oneOf": [
            {
              "type": "integer",
              "enum": [
                1,
                2
              ]
            },
            {
              "type": "number",
              "enum": [
                1.5
              ]
            }
          ],
          "description": "Number of stop bits",
          "default": 1
        },
        "parity": {
          "type": "string",
          "enum": [
            "none",
            "even",
            "odd"
          ],
          "default": "none"
        }
      }
    },
    "memoryConfig": {
      "type": "object",
      "description": "Memory configuration for radio segments",
      "required": [
        "chunkSize",
        "addressSize",
        "addressEndianness",
        "segments"
      ],
      "properties": {
        "chunkSize": {
          "type": "integer",
          "description": "Size of memory chunks in bytes",
          "minimum": 1
        },
        "addressSize": {
          "type": "integer",
          "description": "Size of addresses in bytes for memory operations",
          "minimum": 1,
          "maximum": 4
        },
        "addressEndianness": {
          "type": "string",
          "description": "Byte order for address values in memory operations",
          "enum": [
            "big",
            "little"
          ]
        },
        "segments": {
          "type": "object",
          "description": "Memory segment definitions",
          "additionalProperties": {
            "type": "object",
            "required": [
              "startAddress",
              "endAddress"
            ],
            "properties": {
              "startAddress": {
                "type": "integer",
                "description": "Starting address of the memory segment",
                "minimum": 0
              },
              "endAddress": {
                "type": "integer",
                "description": "Inclusive ending address of the memory segment",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "readMemory": {
      "type": "array",
      "description": "Protocol steps for reading memory",
      "items": {
        "$ref": "#/definitions/protocolStep"
      }
    },
    "writeMemory": {
      "type": "array",
      "description": "Protocol steps for writing memory",
      "items": {
        "$ref": "#/definitions/protocolStep"
      }
    }
  },
  "definitions": {
    "protocolStep": {
      "description": "A single protocol step: an exchange, a chunked read, or a chunked write",
      "oneOf": [
        {
          "$ref": "#/definitions/readStep"
        },
        {
          "$ref": "#/definitions/writeStep"
        },
        {
          "$ref": "#/definitions/exchangeStep"
        }
      ]
    },
    "byteToken": {
      "description": "A send/expect token: a byte, hex string (0x50), ASCII opcode (S), or placeholder ($address)",
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "sendData": {
      "type": "array",
      "description": "Bytes and placeholders to send",
      "items": {
        "$ref": "#/definitions/byteToken"
      }
    },
    "expect": {
      "description": "Expected serial reply: exact byte(s), opaque length, or a framed pattern",
      "oneOf": [
        {
          "$ref": "#/definitions/byteToken"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/byteToken"
          },
          "minItems": 1
        },
        {
          "type": "object",
          "required": [
            "bytes"
          ],
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "type": "integer",
              "description": "Accept any content of this many bytes",
              "minimum": 1
            }
          }
        }
      ]
    },
    "exchangeStep": {
      "type": "object",
      "description": "Send bytes and/or wait for a reply",
      "anyOf": [
        {
          "required": [
            "send"
          ]
        },
        {
          "required": [
            "expect"
          ]
        }
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "description": "Human-readable description of the step"
        },
        "send": {
          "$ref": "#/definitions/sendData"
        },
        "expect": {
          "$ref": "#/definitions/expect"
        },
        "timeout": {
          "type": "integer",
          "description": "Timeout in milliseconds",
          "minimum": 1,
          "default": 5000
        }
      }
    },
    "readStep": {
      "type": "object",
      "description": "Chunked memory read",
      "required": [
        "read"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "description": "Human-readable description of the step"
        },
        "read": {
          "type": "object",
          "required": [
            "segments",
            "send",
            "expect"
          ],
          "additionalProperties": false,
          "properties": {
            "segments": {
              "type": "array",
              "description": "Memory segment names to read",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "send": {
              "$ref": "#/definitions/sendData"
            },
            "expect": {
              "$ref": "#/definitions/expect"
            },
            "ack": {
              "$ref": "#/definitions/exchangeStep",
              "description": "Optional exchange after each chunk"
            },
            "timeout": {
              "type": "integer",
              "description": "Timeout in milliseconds for each chunk exchange",
              "minimum": 1
            }
          }
        }
      }
    },
    "writeStep": {
      "type": "object",
      "description": "Chunked memory write",
      "required": [
        "write"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "description": "Human-readable description of the step"
        },
        "write": {
          "type": "object",
          "required": [
            "segments",
            "send",
            "expect"
          ],
          "additionalProperties": false,
          "properties": {
            "segments": {
              "type": "array",
              "description": "Memory segment names to write",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "send": {
              "$ref": "#/definitions/sendData"
            },
            "expect": {
              "$ref": "#/definitions/expect"
            },
            "timeout": {
              "type": "integer",
              "description": "Timeout in milliseconds for each chunk exchange",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
