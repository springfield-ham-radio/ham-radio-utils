{
  "name": "@springfield/ham-radio-utils",
  "version": "2.2.2",
  "author": "Bryan Hunt",
  "license": "MIT",
  "packageManager": "yarn@4.9.2",
  "readme": "README.md",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "src/",
    "dist/"
  ],
  "scripts": {
    "build": "tsc && cp src/db/* dist/db/ && cp src/schemas/* dist/schemas/",
    "commitlint": "commitlint --edit",
    "lint": "oxlint --import-plugin --tsconfig tsconfig.json",
    "lint:fix": "oxlint --import-plugin --tsconfig tsconfig.json --fix --fix-suggestions",
    "release": "semantic-release",
    "prepare": "husky"
  },
  "release": {
    "branches": [
      "main",
      {
        "name": "beta",
        "prerelease": true
      }
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/changelog",
      "semantic-release-yarn",
      "@semantic-release/gitlab",
      "@semantic-release/git"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@springfield/ham-radio-api": "^16.1.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fishery": "^2.3.1",
    "loglayer": "^6.6.0",
    "sprintf-js": "^1.1.3"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/gitlab": "13.2.6",
    "@types/chai": "5.2.2",
    "@types/sprintf-js": "1.1.4",
    "chai": "5.2.1",
    "husky": "9.1.7",
    "oxlint": "1.11.2",
    "semantic-release": "23.1.1",
    "semantic-release-yarn": "3.0.2",
    "typescript": "5.9.2"
  }
}
