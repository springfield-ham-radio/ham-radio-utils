{
  "name": "@springfield/ham-radio-utils",
  "version": "3.2.6",
  "author": "Bryan Hunt",
  "license": "MIT",
  "readme": "README.md",
  "files": [
    "src/",
    "dist/"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/springfield-ham-radio/ham-radio-utils.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && cp src/db/* dist/db/ && cp src/schemas/* dist/schemas/",
    "commitlint": "commitlint --edit",
    "format": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "release": "semantic-release",
    "prepare": "husky"
  },
  "dependencies": {
    "@springfield/ham-radio-api": "^16.3.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fishery": "^2.4.0",
    "loglayer": "^9.4.0",
    "sprintf-js": "^1.1.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@types/chai": "5.2.3",
    "@types/node": "26.2.0",
    "@types/sprintf-js": "1.1.4",
    "chai": "6.2.2",
    "husky": "9.1.7",
    "oxfmt": "^0.64.0",
    "oxlint": "1.79.0",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2"
  },
  "resolutions": {
    "conventional-changelog-conventionalcommits": "9.3.1"
  },
  "release": {
    "branches": [
      "main",
      {
        "name": "beta",
        "prerelease": true
      }
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/github",
      "@semantic-release/git"
    ]
  },
  "packageManager": "yarn@4.18.0"
}
